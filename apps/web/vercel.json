{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/sports.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tmdb.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "api/translate.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/imdb-videos.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/:slug/:action(play)",
      "destination": "/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "origin"
        }
      ]
    }
  ]
}
