# TMDB API key used by the CinePro Core container.
# Copy this file to .env and add your key. Never commit .env.
TMDB_API_KEY=your_tmdb_api_key_here

# OpenSubtitles API key (create a free consumer in your OpenSubtitles account).
# Configure this value in Vercel Environment Variables; never commit the real key.
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
